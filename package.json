{
  "name": "@putdotio/putio-dev-agent-plugin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "lint:actions": "github-actionlint .github/workflows/*.yml",
    "markdown:check": "oxfmt --check \"**/*.md\"",
    "skills:lint": "skillcheck lint",
    "verify": "pnpm run lint:actions && pnpm run markdown:check && pnpm run skills:lint"
  },
  "devDependencies": {
    "@uinaf/skillcheck": "1.7.7",
    "github-actionlint": "1.7.12",
    "oxfmt": "0.73.0"
  }
}
